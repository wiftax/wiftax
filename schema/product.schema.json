{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wif.tax/schema/product.schema.json",
  "title": "wif.tax product assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "vendor", "product", "website", "status", "surfaces", "hygiene", "summary"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Filename slug, e.g. datadog-api" },
    "vendor": { "type": "string" },
    "product": { "type": "string" },
    "website": { "type": "string", "format": "uri" },
    "docs": { "type": "string", "format": "uri", "description": "Root of the product's auth documentation" },
    "category": { "type": "string", "enum": ["cloud", "saas", "devtools", "data", "security", "observability", "comms", "identity", "other"] },
    "status": { "type": "string", "enum": ["listed", "graduated", "disputed"] },
    "graduated_on": { "type": "string", "format": "date" },
    "summary": { "type": "string", "maxLength": 600, "description": "One or two plain sentences a buyer can read in five seconds." },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inbound", "outbound"],
      "properties": {
        "inbound": { "$ref": "#/$defs/surface" },
        "outbound": { "$ref": "#/$defs/surface" }
      }
    },
    "hygiene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expiry", "rotation_api", "scoping", "last_used", "leak_revocation"],
      "properties": {
        "expiry": { "$ref": "#/$defs/check" },
        "rotation_api": { "$ref": "#/$defs/check" },
        "scoping": { "$ref": "#/$defs/check" },
        "last_used": { "$ref": "#/$defs/check" },
        "leak_revocation": { "$ref": "#/$defs/check" }
      }
    },
    "vendor_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "date", "quote"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "date": { "type": "string", "format": "date" },
        "quote": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "grade": { "type": "string", "enum": ["A", "B", "C", "D", "F", "N/A"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "checked_on"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "checked_on": { "type": "string", "format": "date" },
        "checked_by": { "type": "string", "description": "GitHub handle, or 'sisyphus' for the crawler" },
        "quote": { "type": "string", "maxLength": 400, "description": "Short verbatim excerpt that supports the claim" }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "mechanism", "evidence"],
      "properties": {
        "grade": { "$ref": "#/$defs/grade" },
        "mechanism": { "type": "string", "description": "The best available auth mechanism, in one sentence" },
        "tier_gated": { "type": "string", "description": "Plan or tier required for the graded mechanism, if any" },
        "issuers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "For grade B: the fixed issuer allowlist. For grade A: 'any'."
        },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "notes": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "evidence"],
      "properties": {
        "pass": { "type": ["boolean", "null"], "description": "null = not applicable (no static credential exists)" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "notes": { "type": "string" }
      }
    }
  }
}
